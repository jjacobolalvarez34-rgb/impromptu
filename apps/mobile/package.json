{
  "name": "@impromptu/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App de Android nativa de Impromptu (Kotlin + Jetpack Compose, ADR-019).",
  "type": "module",
  "scripts": {
    "partitura": "vite build --config partitura/vite.config.ts",
    "typecheck": "tsc -p .",
    "apk": "pnpm partitura && node scripts/gradle.mjs assembleDebug",
    "apk:firmado": "pnpm partitura && node scripts/release.mjs",
    "pruebas": "node scripts/gradle.mjs testDebugUnitTest"
  },
  "devDependencies": {
    "@impromptu/core": "workspace:*",
    "@impromptu/notation": "workspace:*",
    "@types/node": "catalog:",
    "opensheetmusicdisplay": "2.2.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
